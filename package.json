{
  "name": "paykal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PayKal — PWA de messagerie et de rechargement/paiement (React + TypeScript + Vite + Supabase)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:fast": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "postbuild": "node scripts/check-dist.mjs",
    "dist:check": "node scripts/check-dist.mjs",
    "package:netlify": "node scripts/package-netlify.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
